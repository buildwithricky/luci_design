          "$type": "color",
          "$value": "{green.800}",
          "$description": "Primary hover fill"
        },
        "pressed": {
          "$type": "color",
          "$value": "{green.950}",
          "$description": "Primary pressed fill"
        }
      },
      "tonal": {
        "background": {
          "$type": "color",
          "$value": "{green.50}",
