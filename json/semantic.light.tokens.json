{
  "color": {
    "background": {
      "canvas": {
        "$type": "color",
        "$value": "{neutral.50}",
        "$description": "App and page background"
      },
      "surface": {
        "$type": "color",
        "$value": "{neutral.0}",
        "$description": "Standard surface: cards, panels, sidebar"
      },
      "surface-raised": {
        "$type": "color",
        "$value": "{neutral.0}",
        "$description": "Card that sits above another surface"
      },
      "surface-sunken": {
        "$type": "color",
        "$value": "{neutral.100}",
        "$description": "Wells inside a surface: code, input groups, filter bars"
      },
      "surface-overlay": {
        "$type": "color",
        "$value": "{neutral.0}",
        "$description": "Menus, popovers, modals, drawers"
      },
      "surface-inverse": {
        "$type": "color",
        "$value": "{green.900}",
        "$description": "Tooltips and toasts"
      },
      "hover": {
        "$type": "color",
        "$value": "{neutral.100}",
        "$description": "Hover fill for rows, menu items, ghost buttons"
      },
      "selected": {
        "$type": "color",
        "$value": "{green.50}",
        "$description": "Selected rows, chips, nav items"
      },
      "scrim": {
        "$type": "color",
        "$value": "{scrim.light}",
        "$description": "Dims the page behind modals and onboarding spotlight"
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "{neutral.950}",
        "$description": "Headings and body text"
      },
      "secondary": {
        "$type": "color",
        "$value": "{neutral.700}",
        "$description": "Supporting text, labels, metadata"
      },
      "muted": {
        "$type": "color",
        "$value": "{neutral.600}",
        "$description": "Placeholder, helper text, timestamps"
      },
      "disabled": {
        "$type": "color",
        "$value": "{neutral.500}",
        "$description": "Disabled controls only"
      },
      "inverse": {
        "$type": "color",
        "$value": "{neutral.50}",
        "$description": "Text on surface-inverse"
      },
      "link": {
        "$type": "color",
        "$value": "{green.600}",
        "$description": "Inline links"
      },
      "selected": {
        "$type": "color",
        "$value": "{green.900}",
        "$description": "Text on color.background.selected"
      }
    },
