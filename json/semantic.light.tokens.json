        "background": {
          "$type": "color",
          "$value": "{success.tint-light}",
          "$description": "Success banner and badge fill"
        }
      },
      "warning": {
        "foreground": {
          "$type": "color",
          "$value": "{warning.light}",
          "$description": "Warning text and icon"
        },
        "background": {
          "$type": "color",
          "$value": "{warning.tint-light}",
          "$description": "Warning banner and badge fill"
        }
      },
      "danger": {
        "foreground": {
          "$type": "color",
          "$value": "{danger.light}",
          "$description": "Error text, icon and invalid-field border"
        },
        "background": {
          "$type": "color",
          "$value": "{danger.tint-light}",
          "$description": "Error banner and badge fill"
        }
      },
      "info": {
        "foreground": {
          "$type": "color",
          "$value": "{info.light}",
          "$description": "Information text and icon"
        },
        "background": {
          "$type": "color",
          "$value": "{info.tint-light}",
          "$description": "Info banner and badge fill"
        }
      }
