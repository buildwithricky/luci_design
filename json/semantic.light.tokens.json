    "chart": {
      "series-1": {
        "$type": "color",
        "$value": "{green.600}",
        "$description": "First data series"
      },
      "series-2": {
        "$type": "color",
        "$value": "{info.light}",
        "$description": "Second data series"
      },
      "series-3": {
        "$type": "color",
        "$value": "{warning.light}",
        "$description": "Third data series"
      },
      "series-4": {
        "$type": "color",
        "$value": "{neutral.500}",
        "$description": "Fourth series or 'other'"
      },
      "grid": {
        "$type": "color",
        "$value": "{neutral.100}",
        "$description": "Gridlines"
      },
      "axis": {
        "$type": "color",
        "$value": "{neutral.500}",
        "$description": "Axis lines and ticks"
      }
    }
