          "$description": "Text on danger"
        },
        "hover": {
          "$type": "color",
          "$value": "{danger.light-hover}",
          "$description": "Danger hover fill"
        }
      },
      "disabled": {
        "background": {
          "$type": "color",
          "$value": "{neutral.100}",
          "$description": "Disabled control fill"
