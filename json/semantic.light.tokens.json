  "elevation": {
    "raised": {
      "$type": "shadow",
      "$value": "0 1px 2px rgb(20 20 20 / 0.06), 0 1px 1px rgb(20 20 20 / 0.04)",
      "$description": "Raised cards"
    },
    "overlay": {
      "$type": "shadow",
      "$value": "0 4px 12px rgb(20 20 20 / 0.10), 0 1px 2px rgb(20 20 20 / 0.06)",
      "$description": "Menus, popovers, tooltips"
    },
    "modal": {
      "$type": "shadow",
      "$value": "0 16px 40px rgb(20 20 20 / 0.16), 0 2px 6px rgb(20 20 20 / 0.06)",
      "$description": "Modals and drawers"
    }
  }
